#!/usr/bin/env python3
"""MCP Lens - Zero-Dependency Model Context Protocol Traffic Sniffer & Schema Auditor.

Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
"""

from __future__ import annotations

import os
import sys


def _resolve_src_dir() -> str:
    here = os.path.realpath(__file__)
    script_root = os.path.dirname(os.path.dirname(here))
    candidates = []

    env_repo = os.environ.get("ZOTH_REPO_DIR", "").strip()
    if env_repo:
        candidates.append(env_repo)

    candidates.append(script_root)
    candidates.append(os.path.join(os.path.expanduser("~"), "NullAITech", "mcp-lens"))
    candidates.append("/opt/mcp-lens")

    for root in candidates:
        src = os.path.join(root, "src")
        if os.path.isdir(os.path.join(src, "mcp_lens")):
            return src
    return os.path.join(script_root, "src")


SRC_DIR = _resolve_src_dir()
if SRC_DIR not in sys.path:
    sys.path.insert(0, SRC_DIR)

from mcp_lens.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
